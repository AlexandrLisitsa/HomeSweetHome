# Home Assistant secrets -- EXAMPLE.
#
# Copy to /config/secrets.yaml on the Home Assistant box and fill in your own
# values. The real file never leaves the box: ha_pull.sh does not fetch it and
# .gitignore blocks it everywhere.

# --- IR bridge (IRBridge/, config/irbridge/rest_commands.yaml) --------------
# The token is shown on the app's main screen.
irbridge_token: 0123456789abcdef0123456789abcdef
# One URL per endpoint, because !secret replaces a whole value. Give the phone a
# static DHCP lease; if it moves, only these lines change.
irbridge_url_ac_resend: "http://<phone-ip>:8765/ac/resend"
irbridge_url_ac_set: "http://<phone-ip>:8765/ac/set"
irbridge_url_ac_state: "http://<phone-ip>:8765/ac/state"
irbridge_url_ac_swing: "http://<phone-ip>:8765/ac/swing"
irbridge_url_ac_swing_step: "http://<phone-ip>:8765/ac/swing/step"
irbridge_url_codes_send: "http://<phone-ip>:8765/codes/{{ idx }}/send"
irbridge_url_health: "http://<phone-ip>:8765/health"
irbridge_url_ir_broadlink: "http://<phone-ip>:8765/ir/broadlink"
irbridge_url_ir_pronto: "http://<phone-ip>:8765/ir/pronto"
irbridge_url_ir_raw: "http://<phone-ip>:8765/ir/raw"
irbridge_url_sweep_mark: "http://<phone-ip>:8765/sweep/mark"
irbridge_url_sweep_start: "http://<phone-ip>:8765/sweep/start"
irbridge_url_sweep_step: "http://<phone-ip>:8765/sweep/step"
irbridge_url_sweep_stop: "http://<phone-ip>:8765/sweep/stop"

# --- DTEK outage schedule (config/packages/dtek_shutdowns.yaml) -------------
# Spelled exactly the way DTEK spells them; look them up with
#   python3 /config/dtek/dtek_poll.py --find "<city>" --street "<first letters>"
dtek_city: "<city>"
dtek_street: "<street>"
dtek_house: "<house number>"

# --- Monthly gas reading (config/packages/gas_submit.yaml) -----------------
# MeterBots' GASBOT_TOKEN (its .env): lets HA use /gas/bot/status and /submit.
gasbot_token: "<same value as GASBOT_TOKEN>"
gasbot_status_url: "http://<meterbots-ip>:8770/gas/bot/status"
gasbot_submit_url: "http://<meterbots-ip>:8770/gas/bot/submit"
# MeterBots' YASNOBOT_TOKEN: lets HA use /yasno/bot/status and /submit,
# the monthly electricity reading (packages/electricity_submit.yaml).
yasnobot_token: "<same value as YASNOBOT_TOKEN>"
yasnobot_status_url: "http://<meterbots-ip>:8770/yasno/bot/status"
yasnobot_submit_url: "http://<meterbots-ip>:8770/yasno/bot/submit"
# The weekly "still logged in?" check (packages/meterbots_session.yaml);
# opened with gasbot_token.
meterbots_session_url: "http://<meterbots-ip>:8770/session"
# Proxmox off-site backup alerts (packages/backup_alerts.yaml): the webhook's
# only protection, so make it long and random. The Proxmox host's
# /etc/default/vzdump-offsite holds the same id in HA_WEBHOOK_URL.
backup_alert_webhook_id: "<a long random string>"
# Optional: where gas_submit.py fetches the photo, and the token MeterCam
# asks for (its METERCAM_TOKEN).
metercam_url: "http://<metercam-ip>:8770"
metercam_token: "<same value as METERCAM_TOKEN>"
# MeterCam's /health (open), polled by packages/metercam_watch.yaml.
metercam_health_url: "http://<metercam-ip>:8770/health"
