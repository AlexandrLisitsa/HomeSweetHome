# Copy to secrets.env (gitignored) and fill in the token.
#
# HA_TOKEN is a long-lived access token, created in the Home Assistant UI:
#   avatar (bottom-left) -> Security -> Long-lived access tokens -> Create token
# It is shown once. It is a full-admin bearer credential; revoke it in the same
# panel at any time.
#
# Keep this file LF-only: tools/ha_get.sh sources it with `.`, and a CR would
# end up inside the token value.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
