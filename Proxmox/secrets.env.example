# Copy to secrets.env (gitignored) and paste the token secret.
#
# Create the token in the Proxmox UI:
#   Datacenter -> Permissions -> API Tokens -> Add
#     User:     root@pam
#     Token ID: claude
#
# IMPORTANT: "Privilege Separation" is ticked by default, and a separated token
# starts with NO permissions at all - every call returns 403 until you grant it
# a role. Either untick it, or leave it ticked and add:
#   Datacenter -> Permissions -> Add -> API Token Permission
#     Path: /        Token: root@pam!claude        Role: PVEAuditor
#
# PVEAuditor is read-only: it can see every node, VM, config and metric, and
# change nothing. That is all this module needs.
#
# The secret is displayed exactly once, when the token is created.
PVE_URL=https://<proxmox-ip>:8006
PVE_TOKEN_ID=root@pam!claude
PVE_TOKEN_SECRET=
