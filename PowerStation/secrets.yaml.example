# Copy this file to `secrets.yaml` and fill in real values.
# `secrets.yaml` is gitignored and must never be committed.

# WiFi network the ESP32 joins.
wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"

# Home Assistant API encryption key.
# Generate a fresh one with: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
api_encryption_key: "base64-encoded-32-byte-key"

# OTA upload password. Any string; pick something long and random.
ota_password: "set-a-long-random-password"

# Bluetooth MAC of the JK BMS (shown in the JK BMS app, or by an ESPHome BLE scan).
bms_mac_address: "AA:BB:CC:DD:EE:FF"
