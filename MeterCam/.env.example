# Copy to .env next to docker-compose.yml, in the LXC (/opt/metercam/.env).
# Git-ignored: both values are private. After editing:
#   docker compose up -d --force-recreate

# MeterCam's own token, sent by the camera and by humans as X-Auth-Token.
# Unset, auth is off and /health says "auth": "DISABLED" (docs/api.md).
METERCAM_TOKEN=

# A Home Assistant long-lived token, minted for MeterCam alone: the prevalue
# fetch and the reading write-back. Unset, readings are gated and archived but
# reach nothing.
METERCAM_HA_TOKEN=<a Home Assistant long-lived token>
