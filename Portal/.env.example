# /opt/portal/.env on the Portal LXC (root:portal, 640). Never committed.
# Both services load it: Caddy for the upstream addresses, Homepage for those
# and the read-only credentials behind its widgets. Homepage only substitutes
# variables named HOMEPAGE_VAR_*, so the addresses use that prefix too.

# The names Homepage answers to, through Caddy.
HOMEPAGE_ALLOWED_HOSTS=home.lan

# Upstreams, host:port. 192.0.2.x stands in for the house subnet.
HOMEPAGE_VAR_PVE_ADDR=192.0.2.2:8006
HOMEPAGE_VAR_HA_ADDR=192.0.2.3:8123
HOMEPAGE_VAR_ADGUARD_ADDR=192.0.2.4:80
HOMEPAGE_VAR_METERCAM_ADDR=192.0.2.8:8770
HOMEPAGE_VAR_METER_ADDR=192.0.2.9:80
HOMEPAGE_VAR_METERBOTS_ADDR=192.0.2.10:8770

# Proxmox API token, made for this page alone and read-only, like root@pam!claude:
#   pveum user token add root@pam homepage --privsep 1
#   pveum acl modify / --tokens 'root@pam!homepage' --roles PVEAuditor
# privsep 1 is the point: without it the token would carry all of root's rights.
HOMEPAGE_VAR_PVE_TOKEN_ID=root@pam!homepage
HOMEPAGE_VAR_PVE_TOKEN_SECRET=

# An AdGuard Home login (Settings -> there is one user; or add one in AdGuardHome.yaml).
HOMEPAGE_VAR_ADGUARD_USER=
HOMEPAGE_VAR_ADGUARD_PASSWORD=

# A Home Assistant long-lived token (Profile -> Security), named "Homepage".
HOMEPAGE_VAR_HA_TOKEN=
