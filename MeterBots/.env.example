# Copy to .env next to docker-compose.yml, in the LXC (/opt/meterbots/.env).
# Git-ignored: every value here is private. After editing:
#   docker compose up -d --force-recreate

# The Telegram session's API credentials: https://my.telegram.org ->
# API development tools. Shared by every bot.
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# The gas reading (@mygrmu_bot). The token is what Home Assistant sends as
# X-Gasbot-Token (its secrets.yaml: gasbot_token); unset, /gas/bot/* refuses
# everyone.
GASBOT_TOKEN=<a long random string>
GASBOT_ACCOUNT=<the Gazmerezhi personal account, 031...>
GASBOT_COUNTER=<the gas meter's serial, as the bot shows it>
# Optional: only if the operator moves the bot (default mygrmu_bot).
# GASBOT_BOT=mygrmu_bot

# The electricity reading (@Yasnoonlinebot). The token is what Home Assistant
# sends as X-Yasnobot-Token (secrets.yaml: yasnobot_token); unset,
# /yasno/bot/* refuses everyone. The account must be saved in the bot once
# (docs/yasno-bot.md, "explore").
YASNOBOT_TOKEN=<a long random string>
YASNOBOT_ACCOUNT=<the 12-digit YASNO personal account>
# Optional: only if YASNO moves the bot (default Yasnoonlinebot).
# YASNOBOT_BOT=Yasnoonlinebot
